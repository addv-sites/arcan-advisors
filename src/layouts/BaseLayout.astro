---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';
// Self-hosted (PageSpeed marcó Google Fonts como render-blocking: CSS de
// fonts.googleapis.com + 2 archivos .woff2 de fonts.gstatic.com, 3
// round-trips cross-origin antes de poder pintar texto). Fontsource
// empaqueta los mismos archivos que sirve Google — Vite los copia al build
// y quedan same-origin, sin la cadena de dependencia externa. Solo los 3
// pesos que usa el CSS del sitio (ver grep en el commit que lo cambió).
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import { SITE } from '../data/site.js';
import { SERVICIOS } from '../data/services.js';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(`${base}og-image.png`, Astro.site).toString();
// Logo real cuadrado (generate-icons.mjs, desde el favicon-package del
// cliente) — Google Organization.logo pide un logo cuadrado/reconocible,
// no el banner 1200x630 de og:image.
const logoUrl = new URL(`${base}icon-512.png`, Astro.site).toString();

// LCP: precargar la foto del Hero (arriba del fold, fetchpriority="high" en
// Hero.astro) — mismo patrón existsSync que el resto del sitio, nunca un
// preload a un archivo que no existe. imagesrcset/imagesizes en vez de href
// fijo: tiene que precargar la misma variante que el navegador va a elegir
// del srcset de Hero.astro (scripts/generate-hero-sizes.mjs), si no
// precarga el archivo grande igual y el srcset no sirve para nada.
const heroImageFile = 'hero-energia.webp';
const hasHeroImage = existsSync(join(process.cwd(), 'public', 'images', 'hero', heroImageFile));
const heroImageSrcset = [640, 1024, 1920]
  .map((w) => `${base}images/hero/hero-energia${w === 1920 ? '' : `-${w}`}.webp ${w}w`)
  .join(', ');

const serviceNodes = SERVICIOS.map((s) => ({
  '@type': 'Service',
  name: s.title,
  description: s.text,
  provider: { '@id': `${SITE.url}#organization` },
  areaServed: 'México',
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}#organization`,
      name: SITE.name,
      url: SITE.url,
      logo: logoUrl,
      email: SITE.email,
      telephone: SITE.whatsapp,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${SITE.address.street}, ${SITE.address.floor}`,
        addressLocality: SITE.address.city,
        addressRegion: 'CDMX',
        postalCode: SITE.address.zip.replace('C.P. ', ''),
        addressCountry: 'MX',
      },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE.url}#service`,
      name: SITE.name,
      description,
      url: SITE.url,
      image: ogImageUrl,
      priceRange: '$$$',
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${SITE.address.street}, ${SITE.address.floor}`,
        addressLocality: SITE.address.city,
        addressRegion: 'CDMX',
        postalCode: SITE.address.zip.replace('C.P. ', ''),
        addressCountry: 'MX',
      },
      areaServed: 'México',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: SITE.email,
        telephone: SITE.whatsapp,
        areaServed: ['MX'],
        availableLanguage: ['es'],
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios Arcan Advisors',
        itemListElement: serviceNodes.map((service) => ({
          '@type': 'Offer',
          itemOffered: service,
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#031c0e" />
    <link rel="canonical" href={canonicalUrl} />

    {hasHeroImage && (
      <link rel="preload" as="image" imagesrcset={heroImageSrcset} imagesizes="100vw" fetchpriority="high" />
    )}

    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <slot />
    <script>
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
