---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Hero from '../components/sections/Hero.astro';
import Nosotros from '../components/sections/Nosotros.astro';
import Servicios from '../components/sections/Servicios.astro';
import Producto from '../components/sections/Producto.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<BaseLayout
  title="Arcan Advisors — Inteligencia Energética"
  description="Consultoría estratégica para la transición energética en México y Latinoamérica. Asesoría en licitaciones, formación de mercado eléctrico, productos ambientales y consultoría estratégica con ARCAN Intelligence™."
>
  <Nav />
  <main id="main">
    <Hero />
    <Nosotros />
    <Servicios />
    <Producto />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
