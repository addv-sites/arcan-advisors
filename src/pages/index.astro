---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Hero from '../components/sections/Hero.astro';
import Nosotros from '../components/sections/Nosotros.astro';
import Servicios from '../components/sections/Servicios.astro';
import Producto from '../components/sections/Producto.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<BaseLayout
  title="Arcan Advisors — Inteligencia Energética | México"
  description="Consultoría estratégica en transición energética para México y Latinoamérica: licitaciones, mercado eléctrico, productos ambientales y ARCAN Intelligence™."
>
  <Nav />
  <main id="main">
    <Hero />
    <Nosotros />
    <Servicios />
    <Producto />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
