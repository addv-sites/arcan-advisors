---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Hero from '../components/sections/Hero.astro';
import Nosotros from '../components/sections/Nosotros.astro';
import Servicios from '../components/sections/Servicios.astro';
import Producto from '../components/sections/Producto.astro';
import Contacto from '../components/sections/Contacto.astro';
---

<BaseLayout
  title="Arcan Advisors: Estrategia de compra de energía | México"
  description="Asesoría estratégica en compra de energía para grandes consumidores y participantes del Mercado Eléctrico Mayorista en México. Experiencia senior desde el suministro, ahora del lado del comprador."
>
  <Nav />
  <main id="main">
    <Hero />
    <Nosotros />
    <Servicios />
    <Producto />
    <Contacto />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
