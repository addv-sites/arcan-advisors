---
import Logo from './Logo.astro';
import { SITE } from '../data/site.js';

const year = new Date().getFullYear();

const links = [
  { href: '#top', label: 'Inicio' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#producto', label: 'Producto' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo variant="negativa" />
      <p>
        Consultoría estratégica para la transición energética en México y Latinoamérica.
      </p>
    </div>

    <nav class="footer-links" aria-label="Enlaces del sitio">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="footer-contact">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={`https://wa.me/${SITE.whatsapp.replace('+', '')}`} target="_blank" rel="noopener">{SITE.whatsappDisplay}</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} Arcan Advisors. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: var(--color-light-gray);
    padding-top: var(--stack-lg);
  }

  .footer-inner {
    display: grid;
    gap: var(--stack-md);
    padding-bottom: var(--stack-md);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }

  .footer-brand p {
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    color: var(--color-medium-gray);
    margin-top: 1rem;
    max-width: 28rem;
  }

  .footer-links,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a,
  .footer-contact a {
    color: var(--color-light-gray);
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.9rem;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible,
  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    color: var(--color-gold);
  }

  .footer-bottom {
    border-top: 1px solid rgb(255 255 255 / 10%);
    padding-block: 1.5rem;
  }

  .footer-bottom p {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    color: var(--color-medium-gray);
    margin: 0;
  }
</style>
