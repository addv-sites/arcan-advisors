---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Logo from './Logo.astro';
import EnergyPattern from './EnergyPattern.astro';
import { SITE } from '../data/site.js';

const year = new Date().getFullYear();

// Reusa la foto del Hero para la banda CTA (mismo recurso, otro recorte) —
// evita pedir un asset nuevo solo para esta franja, como en el MockUp.
const heroImageFile = 'hero-energia.webp';
// process.cwd() = raíz del proyecto — ver nota en Logo.astro sobre por qué
// no se usa import.meta.url-relativo (frágil con el bundling de Vite).
const hasCtaImage = existsSync(join(process.cwd(), 'public', 'images', 'hero', heroImageFile));
const ctaImageSrc = `${import.meta.env.BASE_URL}images/hero/${heroImageFile}`;

const links = [
  { href: '#top', label: 'Inicio' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#producto', label: 'Producto' },
  { href: '#contacto', label: 'Contacto' },
];

// Nombres reales de las 4 líneas de servicio (mismos que Servicios.astro,
// lámina "05. Nuestros Servicios") — todas apuntan a #servicios: es un
// sitio de una sola página, no hay rutas individuales por servicio.
const serviceLinks = [
  'Asesoría en Licitaciones Energéticas',
  'Formación en Mercado Eléctrico Mayorista',
  'Comercialización de Productos Ambientales',
  'Consultoría Estratégica en Energía',
];
---

<div class="footer-cta">
  {hasCtaImage && <img class="footer-cta-photo" src={ctaImageSrc} alt="" loading="lazy" width="1920" height="1081" />}
  <EnergyPattern class="footer-cta-pattern" />
  <div class="footer-cta-fade" aria-hidden="true"></div>

  <div class="container footer-cta-inner">
    <div>
      <p class="footer-cta-title">¿Listo para generar <span>valor</span> en tu negocio?</p>
      <p class="footer-cta-sub">Hagamos de la energía una ventaja estratégica para tu empresa.</p>
    </div>
    <a class="btn btn-primary" href="#contacto">Contáctanos</a>
  </div>
</div>

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-wrap">
        <Logo variant="negativa" footer />
      </div>
      <p>
        Consultoría estratégica para la transición energética en México y Latinoamérica.
      </p>
    </div>

    <nav class="footer-col" aria-label="Enlaces del sitio">
      <p class="footer-col-title">Enlaces</p>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <nav class="footer-col" aria-label="Servicios">
      <p class="footer-col-title">Servicios</p>
      {serviceLinks.map((label) => (
        <a href="#servicios">{label}</a>
      ))}
    </nav>

    <div class="footer-col">
      <p class="footer-col-title">Contacto</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={`https://wa.me/${SITE.whatsapp.replace('+', '')}`} target="_blank" rel="noopener">{SITE.whatsappDisplay}</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} Arcan Advisors. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer-cta {
    position: relative;
    overflow: hidden;
    background: linear-gradient(100deg, #000000 0%, var(--color-forest-green) 100%);
  }

  .footer-cta-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    /* Solo se ve del lado derecho, como en el MockUp — en mobile no hay
       espacio para que respire, se oculta (ver media query abajo). */
    display: none;
  }

  .footer-cta-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #000000 0%, rgb(0 0 0 / 75%) 30%, rgb(3 28 14 / 35%) 60%, rgb(3 28 14 / 10%) 100%);
  }

  @media (min-width: 768px) {
    .footer-cta-photo {
      display: block;
    }
  }

  .footer-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2.5rem;
  }

  .footer-cta-title {
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    color: var(--color-white);
    margin: 0;
  }

  .footer-cta-title span {
    color: var(--color-gold);
  }

  .footer-cta-sub {
    font-family: var(--font-secondary);
    color: var(--color-light-gray);
    margin: 0.5rem 0 0;
  }

  .site-footer {
    /* Forest Green de marca, no Charcoal — fiel a la paleta y al MockUp. */
    background: var(--color-forest-green);
    color: var(--color-light-gray);
    padding-top: var(--stack-lg);
    border-top: 1px solid rgb(255 255 255 / 10%);
  }

  .footer-inner {
    display: grid;
    gap: var(--stack-md);
    padding-bottom: var(--stack-md);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer-logo-wrap {
    /* La columna del footer-brand es más ancha que el logo — sin esto
       queda pegado a la izquierda y se ve desbalanceado respecto al resto
       del bloque. Centrado explícito pedido por el cliente. */
    display: flex;
    justify-content: center;
  }

  .footer-brand p {
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    color: var(--color-light-gray);
    margin-top: 1rem;
    max-width: 28rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    /* Antes: gap 0.15rem (reducido de 0.75rem → 0.4rem → 0.15rem, pedido
       explícito del cliente). PageSpeed/Lighthouse marcó estos links como
       touch target insuficiente (~18px de alto real, mínimo WCAG 44px) —
       confirmado con el cliente, prioriza cumplir 44px. El padding-block
       de abajo en `.footer-col a` reemplaza este gap (evita duplicar
       espacio) y es lo que separa los links ahora. */
    gap: 0;
  }

  .footer-col-title {
    font-family: var(--font-primary);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-white);
    margin: 0 0 0.25rem;
  }

  .footer-col a {
    color: var(--color-light-gray);
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    /* Default (~1.5) dejaba mucho aire en los links de 2 líneas
       ("Formación en Mercado Eléctrico Mayorista", etc). */
    line-height: 1.25;
    /* Touch target real ≥44px (línea 18px + padding): ver nota en
       .footer-col sobre por qué esto reemplaza el gap de antes. */
    padding-block: 0.8rem;
    display: inline-block;
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    /* White, no Gold: Gold sobre Forest Green da 4.09:1, no pasa AA para
       texto normal (min 4.5:1). White da 12.21:1. */
    color: var(--color-white);
  }

  .footer-bottom {
    border-top: 1px solid rgb(255 255 255 / 10%);
    padding-block: 1.5rem;
  }

  .footer-bottom p {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    color: var(--color-light-gray);
    margin: 0;
  }
</style>
