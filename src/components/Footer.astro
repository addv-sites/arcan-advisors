---
import Logo from './Logo.astro';
import { SITE } from '../data/site.js';

const year = new Date().getFullYear();

const links = [
  { href: '#top', label: 'Inicio' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#producto', label: 'Producto' },
  { href: '#contacto', label: 'Contacto' },
];

// Nombres reales de las 4 líneas de servicio (mismos que Servicios.astro,
// lámina "05. Nuestros Servicios") — todas apuntan a #servicios: es un
// sitio de una sola página, no hay rutas individuales por servicio.
const serviceLinks = [
  'Asesoría en Licitaciones Energéticas',
  'Formación en Mercado Eléctrico Mayorista',
  'Comercialización de Productos Ambientales',
  'Consultoría Estratégica en Energía',
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo variant="negativa" />
      <p>
        Consultoría estratégica para la transición energética en México y Latinoamérica.
      </p>
    </div>

    <nav class="footer-col" aria-label="Enlaces del sitio">
      <p class="footer-col-title">Enlaces</p>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <nav class="footer-col" aria-label="Servicios">
      <p class="footer-col-title">Servicios</p>
      {serviceLinks.map((label) => (
        <a href="#servicios">{label}</a>
      ))}
    </nav>

    <div class="footer-col">
      <p class="footer-col-title">Contacto</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={`https://wa.me/${SITE.whatsapp.replace('+', '')}`} target="_blank" rel="noopener">{SITE.whatsappDisplay}</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} Arcan Advisors. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: var(--color-light-gray);
    padding-top: var(--stack-lg);
  }

  .footer-inner {
    display: grid;
    gap: var(--stack-md);
    padding-bottom: var(--stack-md);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer-brand p {
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    /* Light Gray, no Medium Gray: Medium Gray sobre Charcoal da 3.03:1, no
       pasa AA (min 4.5:1). Light Gray sobre Charcoal da 13.82:1. */
    color: var(--color-light-gray);
    margin-top: 1rem;
    max-width: 28rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-col-title {
    font-family: var(--font-primary);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-white);
    margin: 0 0 0.25rem;
  }

  .footer-col a {
    color: var(--color-light-gray);
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.9rem;
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: var(--color-gold);
  }

  .footer-bottom {
    border-top: 1px solid rgb(255 255 255 / 10%);
    padding-block: 1.5rem;
  }

  .footer-bottom p {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    color: var(--color-light-gray);
    margin: 0;
  }
</style>
