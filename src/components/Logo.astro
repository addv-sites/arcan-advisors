---
/*
  variant: 'principal' (fondo claro) | 'negativa' (fondo oscuro) | 'mono' (fondo de color sólido)
  markOnly: true = solo isotipo, sin wordmark (uso secundario permitido por brandbook)

  Para 'negativa' (Nav/Footer, fondo oscuro) se usa el lockup REAL que
  aportó el cliente (public/logo-arcan-advisors.webp). El archivo actual
  (2026-08-06, 1350x436) lo generó Antonio a mano reemplazando el .webp
  directamente — no viene de `scripts/fix-logo-nav.mjs` (ese script sigue
  siendo referencia de cómo se diagnosticó y limpió el checkerboard de
  public/logo-arcan-advisors.jpg en la vuelta anterior, pero quedó
  desincronizado del archivo actual; no asumir que regenerarlo reproduce
  este resultado).
  'principal' y 'mono' siguen siendo el isólogo reconstruido a mano en SVG
  (no hay asset real para esos fondos todavía) — ver gap en PROJECT_STATE.md.
*/
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  variant?: 'principal' | 'negativa' | 'mono';
  markOnly?: boolean;
  class?: string;
  footer?: boolean;
}

const { variant = 'principal', markOnly = false, class: className = '', footer = false } = Astro.props;

// Footer usa un lockup real distinto (public/logo-footer.webp, derivado de
// LogoFooter.png que aportó el cliente) — el ARCAN de ese archivo venía en
// negro (variante fondo claro), se recoloreó a blanco por chroma detection
// (achromático + oscuro → blanco, dorado intacto) para que sea legible
// sobre el Forest Green del footer.
const realLogoFile = footer ? 'logo-footer.webp' : 'logo-arcan-advisors.webp';
// process.cwd() = raíz del proyecto (donde corre `astro build`), no la
// ubicación de este componente — import.meta.url-relativo es frágil acá:
// depende de cómo Vite empaqueta el archivo en build, no del código fuente.
const hasRealLogo = existsSync(join(process.cwd(), 'public', realLogoFile)) && variant === 'negativa' && !markOnly;
const realLogoSrc = `${import.meta.env.BASE_URL}${realLogoFile}`;

const markColor = variant === 'mono' ? 'currentColor' : 'var(--color-gold)';
const arcanColor =
  variant === 'principal' ? 'var(--color-forest-green)' : variant === 'negativa' ? 'var(--color-white)' : 'currentColor';
const advisorsColor = variant === 'mono' ? 'currentColor' : 'var(--color-gold)';
const taglineColor =
  variant === 'principal' ? 'var(--color-medium-gray)' : variant === 'negativa' ? 'var(--color-light-gray)' : 'currentColor';
---

{
  hasRealLogo ? (
    <img
      class={`logo-real ${footer ? 'logo-real--footer' : ''} ${className}`}
      src={realLogoSrc}
      alt="Arcan Advisors — Inteligencia Energética"
      width={footer ? '558' : '1350'}
      height={footer ? '555' : '436'}
    />
  ) : (
    <span class={`logo logo--${variant} ${className}`} style={variant === 'mono' ? 'color: var(--color-white)' : ''}>
      <svg
        class="logo-mark"
        viewBox="0 0 140 100"
        role={markOnly ? 'img' : undefined}
        aria-label={markOnly ? 'Arcan Advisors' : undefined}
        aria-hidden={markOnly ? undefined : 'true'}
        width={markOnly ? '40' : '32'}
        height={markOnly ? '28' : '23'}
      >
        <polygon points="18,90 38,90 62,10 52,10" fill={markColor} />
        <polygon points="58,90 78,90 102,10 92,10" fill={markColor} />
        <polygon points="86,90 106,90 106,52 92,52" fill={markColor} />
      </svg>
      {!markOnly && (
        <span class="logo-wordmark">
          <span class="logo-arcan" style={`color:${arcanColor}`}>
            ARCAN
          </span>
          <span class="logo-advisors" style={`color:${advisorsColor}`}>
            ADVISORS
          </span>
          <span class="logo-tagline" style={`color:${taglineColor}`}>
            INTELIGENCIA ENERGÉTICA
          </span>
        </span>
      )}
    </span>
  )
}

<style>
  .logo-real {
    width: auto;
    /* Reducido 45% y luego 15% más, pedidos por cliente sobre los 125px
       anteriores (64 → 86 → 125 → 69 → 59). Solo aplica al nav — el
       footer tiene su propia clase abajo, no comparten tamaño. */
    height: 59px;
    display: inline-block;
  }

  .logo-real--footer {
    /* Footer nunca pidió estos cambios de tamaño del nav — vuelve a su
       proporción original de antes de esta sesión, luego +15% y +15%
       más, pedidos aparte (64 → 74 → 85). */
    height: 85px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-mark {
    flex-shrink: 0;
  }

  .logo-wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
    /* El lockup real del logo usa un serif (ver brandbook lám. 02/06), distinto
       de Lato (tipografía corporativa para el resto del sitio) — el logo es
       arte fijo, no se "corrige" a la tipografía corporativa. */
    font-family: Georgia, 'Times New Roman', serif;
  }

  .logo-arcan {
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: 0.04em;
  }

  .logo-advisors {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-top: 0.1rem;
  }

  .logo-tagline {
    font-family: var(--font-secondary);
    font-size: 0.42rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    margin-top: 0.15rem;
  }

  /* Corrido ~1cm (38px a 96dpi) a la izquierda del centrado del wrap,
     pedido explícito del cliente — pero solo tiene sentido en el layout
     de footer ancho (Footer.astro pasa a grid en 768px). Sin el media
     query, el mismo corrimiento descentraba el logo en el footer de una
     sola columna en mobile. */
  @media (min-width: 768px) {
    .logo-real--footer {
      transform: translateX(-38px);
    }
  }
</style>
