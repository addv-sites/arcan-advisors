---
// Copy literal — Brand Book Arcan Advisors v1.0, lámina "05. Nuestros Servicios".
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const servicios = [
  {
    title: 'Asesoría en Licitaciones Energéticas',
    text: 'Diseñamos y gestionamos procesos de licitación energética con enfoque estratégico, técnico y regulatorio.',
    items: [
      'Diseño y estructuración de RFPs',
      'Acompañamiento integral en licitaciones',
      'Evaluación técnica y económica',
      'Cumplimiento regulatorio',
      'Gestión de riesgos y optimización de ofertas',
    ],
    icon: 'M9 3h6v3H9V3Z M6 6h12v15H6V6Z M9 13l2 2 4-4',
    image: 'servicio-01-licitaciones.webp',
  },
  {
    title: 'Formación en Mercado Eléctrico Mayorista',
    text: 'Formamos profesionales y empresas con conocimiento práctico y actualizado del mercado eléctrico.',
    items: ['Cursos y talleres especializados', 'Programas in-company', 'Capacitación regulatoria y operativa', 'Análisis de mercado y casos reales'],
    icon: 'M12 3 2 8l10 5 10-5-10-5Z M6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5',
    image: 'servicio-02-formacion.webp',
  },
  {
    title: 'Comercialización de Productos Ambientales',
    text: 'Desarrollamos e intermediamos instrumentos ambientales que impulsan la sostenibilidad y generan valor.',
    items: ['Certificados de Energía Renovable (I-REC)', 'Bonos de carbono', 'Garantías de origen renovable'],
    icon: 'M12 2c4 3 6 6 6 10a6 6 0 1 1-12 0c0-4 2-7 6-10Z',
    image: 'servicio-03-ambientales.webp',
  },
  {
    title: 'Consultoría Estratégica en Energía',
    text: 'Utilizamos ARCAN Intelligence™, nuestra herramienta propietaria de análisis de datos y construcción de RFPs que transforma información en decisiones estratégicas de alto impacto.',
    items: [
      'Análisis avanzado de datos energéticos',
      'Construcción inteligente de RFPs con ARCAN Intelligence™',
      'Modelado de escenarios y simulaciones predictivas',
      'Evaluación de riesgos y oportunidades',
    ],
    icon: 'M12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3',
    image: 'servicio-04-consultoria.webp',
  },
];

// Chequeo real de archivo en build time — mientras IMAGENES_PENDIENTES.md
// no se haya resuelto, cada card cae al placeholder de marca (nunca un
// <img src> roto). Apenas el archivo exista en public/images/servicios/,
// esta misma build lo toma solo, sin tocar el componente.
// process.cwd() = raíz del proyecto — ver nota en Logo.astro sobre por qué
// no se usa import.meta.url-relativo (frágil con el bundling de Vite; es
// justo lo que rompió el logo real y la foto de la banda CTA del footer).
const servicesWithImageStatus = servicios.map((s, i) => ({
  ...s,
  hasImage: existsSync(join(process.cwd(), 'public', 'images', 'servicios', s.image)),
  itemsId: `servicio-items-${i}`,
}));
---

<section class="section section--muted" id="servicios">
  <div class="container">
    <div class="section-header services-header" data-reveal>
      <div>
        <p class="section-eyebrow">Nuestros Servicios</p>
        <h2 class="section-title">Cuatro líneas de servicio, un mismo propósito: generar valor energético.</h2>
      </div>
      <p class="section-lead services-lead">
        Ofrecemos soluciones especializadas que generan valor, impulsan la eficiencia y promueven la transición energética en México y
        Latinoamérica.
      </p>
    </div>

    <div class="cards-grid cards-grid--4" id="servicios-grid" data-reveal-group>
      {servicesWithImageStatus.map((s, i) => (
        <article class="card card--media" data-reveal style={`--reveal-index:${i}`}>
          <div class="card-body">
            <span class="card-icon card-icon--top">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={s.icon} />
              </svg>
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>

            <button type="button" class="card-explore" aria-expanded="false" aria-controls={s.itemsId}>
              <span class="card-explore-label">Explorar</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </button>

            <ul class="card-items" id={s.itemsId}>
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="card-media">
            {s.hasImage ? (
              <img src={`${import.meta.env.BASE_URL}images/servicios/${s.image}`} alt="" loading="lazy" width="400" height="300" />
            ) : (
              <span class="card-media-placeholder" aria-hidden="true"></span>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="banner" data-reveal>
      <p class="banner-title">Soluciones inteligentes para un futuro sostenible.</p>
      <p>
        Cada servicio de Arcan Advisors está diseñado para crear valor sostenible, impulsar la competitividad y acompañar a nuestros
        clientes en la transformación energética.
      </p>
    </div>
  </div>
</section>

<style>
  /* Header 2 columnas — título a la izquierda, bajada corta a la derecha
     con divisor dorado, tal cual el MockUp. */
  .services-header {
    display: block;
  }

  @media (min-width: 900px) {
    .services-header {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 2.5rem;
      align-items: end;
    }
  }

  .services-lead {
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-gold);
  }

  @media (min-width: 900px) {
    .services-lead {
      margin-top: 0;
    }
  }

  .card--media {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Todo centrado — ícono, título, texto, "Explorar" — tal cual el MockUp.
     min-height + flex-column con el botón "Explorar" empujado al fondo
     (margin-top:auto): el texto real (literal del brandbook) varía bastante
     de largo entre servicios — sin esto, cada card termina de una altura
     distinta y las fotos quedan escalonadas en vez de alineadas en fila. */
  .card-body {
    padding: 2rem 1.75rem 1.5rem;
    order: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 320px;
  }

  .card-body h3 {
    margin: 0;
  }

  .card-body p {
    margin: 0.75rem 0 0;
  }

  .card-icon--top {
    /* Charcoal + Gold, no el tinte claro de forest-green de la base
       (.card-icon en global.css) — el MockUp muestra el badge oscuro. */
    background: var(--color-charcoal);
    color: var(--color-gold);
    margin-bottom: 1.25rem;
  }

  .card-explore {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* auto: se empuja al fondo del bloque de texto (min-height de arriba),
       así todas las cards alinean "Explorar" y la foto en la misma fila. */
    margin-top: auto;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-gold);
    font-family: var(--font-secondary);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .card-explore-label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-explore svg {
    width: 18px;
    height: 18px;
    transition: transform var(--duration-base) var(--ease-premium);
  }

  .card-explore[aria-expanded='true'] svg {
    transform: rotate(90deg);
  }

  /* Bullets ocultos por default (fiel al MockUp) SOLO si el JS confirmó
     que corrió — si falla, quedan visibles, nunca se pierde contenido.
     Mismo patrón que src/scripts/reveal.js. */
  .card-items {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    text-align: left;
  }

  html.reveal-ready .card-items {
    display: none;
  }

  html.reveal-ready .card-items.is-open {
    display: grid;
  }

  .card-items li {
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-left: 1.1rem;
    position: relative;
  }

  .card-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-gold);
  }

  .card-media {
    order: 2;
    position: relative;
    /* Antes: aspect-ratio fijo dejaba un hueco en blanco al fondo de la
       card cuando el texto de arriba era más corto que el más largo de la
       fila (min-height:320px del .card-body). flex:1 la hace crecer y
       llegar siempre hasta el borde inferior real de la card. */
    flex: 1;
    min-height: 200px;
    background: linear-gradient(160deg, var(--color-forest-green) 0%, var(--color-dark-olive) 100%);
  }

  .card-media::before {
    /* Fade superior: la foto entra desde blanco (mismo blanco de la card)
       en vez de cortar en seco justo debajo del botón "Explorar". */
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 72px;
    background: linear-gradient(to bottom, var(--color-white) 0%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-media-placeholder {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 20%, rgb(193 134 19 / 25%) 0%, transparent 45%),
      radial-gradient(circle at 80% 70%, rgb(193 134 19 / 18%) 0%, transparent 50%);
  }

</style>

<script>
  document.querySelectorAll('.card-explore').forEach((button) => {
    button.addEventListener('click', () => {
      const targetId = button.getAttribute('aria-controls');
      const list = targetId ? document.getElementById(targetId) : null;
      if (!list) return;

      const isOpen = list.classList.toggle('is-open');
      button.setAttribute('aria-expanded', String(isOpen));
      const label = button.querySelector('.card-explore-label');
      if (label) label.textContent = isOpen ? 'Ocultar' : 'Explorar';
    });
  });
</script>
