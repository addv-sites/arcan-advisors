---
/*
  Copy actualizado según brief de reposicionamiento del cliente (clientCom.md,
  sección 11) — reemplaza la sección "ARCAN Intelligence™" (herramienta
  propietaria) por la presentación correcta de Quanten: plataforma de un
  aliado tecnológico bajo licenciamiento máster, no desarrollo propio de
  Arcan. Enlace autorizado explícitamente por el cliente.
*/
const capacidades = [
  'Precios marginales locales (PML)',
  'Demanda y servicios conexos',
  'Recomendaciones fundamentadas en datos actuales, no en supuestos',
  'Inteligencia de mercado que normalmente no está al alcance del cliente',
];

const quantenUrl = 'https://quanten.com.mx/landing/index.html';
---

<section class="section section--dark" id="producto">
  <div class="container producto-grid">
    <div class="section-header" data-reveal style="margin-bottom:0">
      <p class="section-eyebrow">Producto</p>
      <h2 class="section-title">Inteligencia de mercado con Quanten</h2>
      <p class="section-lead">
        Arcan integra Quanten, una plataforma especializada en datos del Mercado Eléctrico Mayorista —precios marginales locales,
        demanda y servicios conexos— sobre la cual Arcan cuenta con licenciamiento máster. Esto nos permite fundamentar cada
        recomendación en datos actuales del mercado, no en supuestos. El cliente accede a inteligencia de mercado que normalmente no
        está a su alcance, traducida en decisiones de compra concretas.
      </p>
      <a class="btn btn-secondary producto-link" href={quantenUrl} target="_blank" rel="noopener">Conoce Quanten</a>
      <p class="producto-disclaimer">
        Quanten es la plataforma de un aliado tecnológico bajo licencia. Arcan cuenta con licenciamiento máster con derecho a
        sublicenciar — no es un desarrollo propio ni un producto tecnológico de Arcan.
      </p>
    </div>

    <ul class="producto-list" data-reveal-group>
      {capacidades.map((item, i) => (
        <li data-reveal style={`--reveal-index:${i}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z M8.5 12.5l2.5 2.5 5-5" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .producto-grid {
    display: grid;
    gap: var(--stack-lg);
  }

  @media (min-width: 1024px) {
    .producto-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .producto-link {
    margin-top: 1.5rem;
  }

  .producto-disclaimer {
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    /* Sin opacity reducida: bajarla mezcla el color con el fondo oscuro y
       puede tirar el contraste por debajo de 4.5:1 AA. */
    color: var(--color-light-gray);
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 15%);
  }

  .producto-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .producto-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: var(--font-secondary);
    color: var(--color-white);
    font-size: 0.98rem;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: var(--radius-default);
    padding: 0.9rem 1.1rem;
  }

  .producto-list svg {
    width: 20px;
    height: 20px;
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
</style>
