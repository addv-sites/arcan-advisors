---
/*
  Copy literal derivado del servicio 04 (lámina "05. Nuestros Servicios") —
  es la única fuente de contenido sobre ARCAN Intelligence™ en el brandbook.
  No se inventan funcionalidades nuevas. Restricción de posicionamiento
  ("no está a la venta, no es software comercial") viene dada explícita por
  el cliente, no del brandbook — se refleja tal cual, sin agregar promesas.
*/
const capacidades = [
  'Análisis avanzado de datos energéticos',
  'Construcción inteligente de RFPs con ARCAN Intelligence™',
  'Modelado de escenarios y simulaciones predictivas',
  'Evaluación de riesgos y oportunidades',
  'Decisiones informadas, rápidas y rentables',
  'Ventaja competitiva basada en inteligencia de mercado',
];
---

<section class="section section--dark" id="producto">
  <div class="container producto-grid">
    <div class="section-header" data-reveal style="margin-bottom:0">
      <p class="section-eyebrow">Producto</p>
      <h2 class="section-title">ARCAN Intelligence™</h2>
      <p class="section-lead">
        Nuestra herramienta propietaria de análisis de datos y construcción de RFPs que transforma información en decisiones
        estratégicas de alto impacto.
      </p>
      <p class="producto-disclaimer">
        Plataforma propietaria de apoyo a la toma de decisiones — fortalece nuestros servicios de consultoría. No se comercializa de
        forma independiente.
      </p>
    </div>

    <ul class="producto-list" data-reveal-group>
      {capacidades.map((item, i) => (
        <li data-reveal style={`--reveal-index:${i}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z M8.5 12.5l2.5 2.5 5-5" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .producto-grid {
    display: grid;
    gap: var(--stack-lg);
  }

  @media (min-width: 1024px) {
    .producto-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .producto-disclaimer {
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    color: var(--color-light-gray);
    opacity: 0.8;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 15%);
  }

  .producto-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .producto-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: var(--font-secondary);
    color: var(--color-white);
    font-size: 0.98rem;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: var(--radius-default);
    padding: 0.9rem 1.1rem;
  }

  .producto-list svg {
    width: 20px;
    height: 20px;
    color: var(--color-gold);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
</style>
