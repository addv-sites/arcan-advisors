---
/*
  Copy literal de MockUp site.png (headline/subtext/badges), cross-validado
  contra "04. Estrategia de Marca" del brandbook (misma cita textual en
  "Nuestra propuesta de valor"). Fondo: fotografía real (turbinas/paneles al
  amanecer, ver IMAGENES_PENDIENTES.md) + overlay Forest Green + patrón
  "Red de Energía" (motivo de marca real, lámina "03. Sistema Visual").
*/
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import EnergyPattern from '../EnergyPattern.astro';

const badges = [
  { label: 'Experiencia desde el suministro' },
  { label: 'Enfoque en el comprador' },
  { label: 'Atención senior directa' },
];

const heroImageFile = 'hero-energia.webp';
// process.cwd() = raíz del proyecto, no import.meta.url-relativo — ver
// nota en Logo.astro (frágil con cómo Vite empaqueta el componente).
const hasHeroImage = existsSync(join(process.cwd(), 'public', 'images', 'hero', heroImageFile));
const heroImageSrc = `${import.meta.env.BASE_URL}images/hero/${heroImageFile}`;
// Variantes responsive (scripts/generate-hero-sizes.mjs) — el LCP en mobile
// venía de servir el archivo de 1920px a un viewport de ~390px. El Hero
// ocupa el ancho completo del viewport siempre (sizes="100vw").
const heroImageSrcset = [640, 1024, 1920]
  .map((w) => `${import.meta.env.BASE_URL}images/hero/hero-energia${w === 1920 ? '' : `-${w}`}.webp ${w}w`)
  .join(', ');
---

<section class="hero" id="top">
  {hasHeroImage && (
    <img
      class="hero-photo"
      src={heroImageSrc}
      srcset={heroImageSrcset}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1081"
    />
  )}
  <EnergyPattern />

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content" data-reveal-group>
    <h1 class="hero-headline" data-reveal style="--reveal-index:0">
      Conocemos el mercado eléctrico <span class="hero-accent">mexicano</span> <span class="hero-accent">desde adentro</span>
    </h1>
    <p class="hero-sub" data-reveal style="--reveal-index:1">
      Asesoría estratégica en compra de energía para grandes consumidores industriales y participantes del Mercado Eléctrico Mayorista.
      Más de 12 años de experiencia senior que se traducen en estrategias claras, accionables y que generan valor.
    </p>

    <div class="hero-cta-row" data-reveal style="--reveal-index:2">
      <a class="btn btn-primary" href="#servicios">Conoce nuestros servicios</a>
      <a class="btn btn-secondary" href="#contacto">Hablemos de tu proyecto</a>
    </div>

    <ul class="hero-badges" data-reveal style="--reveal-index:3">
      {badges.map((badge) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z"></path>
            <path d="m8.5 12.5 2.5 2.5 5-5"></path>
          </svg>
          <span>{badge.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-forest-green) 0%, var(--color-dark-olive) 100%);
    padding-block: calc(var(--stack-lg) + var(--stack-md)) var(--stack-lg);
    min-height: 640px;
    display: flex;
    align-items: center;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Con foto real de fondo, el texto queda sobre el lado izquierdo —
       oscurecer fuerte ahí y dejar la foto respirar a la derecha. */
    background: linear-gradient(
      100deg,
      rgb(0 0 0 / 82%) 0%,
      rgb(0 0 0 / 68%) 35%,
      rgb(3 28 14 / 35%) 65%,
      rgb(3 28 14 / 15%) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    /* Sin .container: en el MockUp el texto va pegado al borde real de la
       pantalla, no encerrado en el ancho centrado de 1280px que usa el
       resto del sitio — medido, el título del mockup arranca a ~4% del
       viewport, el nuestro arrancaba a ~28% antes de este fix. */
    padding-left: clamp(24px, 6vw, 96px);
    padding-right: var(--margin-mobile);
  }

  .hero-headline {
    font-family: var(--font-primary);
    font-weight: 900;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--color-white);
    letter-spacing: -0.01em;
  }

  .hero-accent {
    color: var(--color-gold);
  }

  .hero-sub {
    font-family: var(--font-secondary);
    color: var(--color-light-gray);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    margin-top: var(--stack-sm);
    max-width: 38rem;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: var(--stack-md);
  }

  .hero-badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: var(--stack-md) 0 0;
    padding: 0;
  }

  .hero-badges li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-light-gray);
    font-family: var(--font-secondary);
    font-size: 0.85rem;
  }

  .hero-badges svg {
    width: 20px;
    height: 20px;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 560px;
      padding-block: var(--stack-lg) var(--stack-md);
    }
  }
</style>
