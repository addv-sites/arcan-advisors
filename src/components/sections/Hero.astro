---
/*
  Copy literal de MockUp site.png (headline/subtext/badges), cross-validado
  contra "04. Estrategia de Marca" del brandbook (misma cita textual en
  "Nuestra propuesta de valor"). Fondo: fotografía real (turbinas/paneles al
  amanecer, ver IMAGENES_PENDIENTES.md) + overlay Forest Green + patrón
  "Red de Energía" (motivo de marca real, lámina "03. Sistema Visual").
*/
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const badges = [
  { label: 'Experiencia comprobada' },
  { label: 'Visión sostenible' },
  { label: 'Compromiso con resultados' },
];

const heroImageFile = 'hero-energia.webp';
const heroImagePath = fileURLToPath(new URL('../../../public/images/hero/', import.meta.url));
const hasHeroImage = existsSync(`${heroImagePath}${heroImageFile}`);
const heroImageSrc = `${import.meta.env.BASE_URL}images/hero/${heroImageFile}`;
---

<section class="hero" id="top">
  {hasHeroImage && <img class="hero-photo" src={heroImageSrc} alt="" loading="eager" fetchpriority="high" width="1920" height="1081" />}
  <svg class="hero-pattern" viewBox="0 0 800 500" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <g stroke="var(--color-gold)" stroke-width="1" opacity="0.35">
      <line x1="40" y1="80" x2="220" y2="160"></line>
      <line x1="220" y1="160" x2="420" y2="90"></line>
      <line x1="220" y1="160" x2="300" y2="320"></line>
      <line x1="420" y1="90" x2="620" y2="180"></line>
      <line x1="300" y1="320" x2="520" y2="380"></line>
      <line x1="520" y1="380" x2="700" y2="260"></line>
      <line x1="620" y1="180" x2="700" y2="260"></line>
    </g>
    <g fill="var(--color-gold)">
      <circle cx="40" cy="80" r="4"></circle>
      <circle cx="220" cy="160" r="5"></circle>
      <circle cx="420" cy="90" r="4"></circle>
      <circle cx="300" cy="320" r="4"></circle>
      <circle cx="620" cy="180" r="4"></circle>
      <circle cx="520" cy="380" r="4"></circle>
      <circle cx="700" cy="260" r="5"></circle>
    </g>
  </svg>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-content" data-reveal-group>
    <h1 class="hero-headline" data-reveal style="--reveal-index:0">
      Inteligencia energética que genera <span class="hero-accent">valor</span>
    </h1>
    <p class="hero-sub" data-reveal style="--reveal-index:1">
      Convertimos la complejidad del sector energético en estrategias claras, accionables y que generan valor.
    </p>

    <div class="hero-cta-row" data-reveal style="--reveal-index:2">
      <a class="btn btn-primary" href="#servicios">Conoce nuestros servicios</a>
      <a class="btn btn-secondary" href="#contacto">Hablemos de tu proyecto</a>
    </div>

    <ul class="hero-badges" data-reveal style="--reveal-index:3">
      {badges.map((badge) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z"></path>
            <path d="m8.5 12.5 2.5 2.5 5-5"></path>
          </svg>
          <span>{badge.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-forest-green) 0%, var(--color-dark-olive) 100%);
    padding-block: calc(var(--stack-lg) + var(--stack-md)) var(--stack-lg);
    min-height: 640px;
    display: flex;
    align-items: center;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Con foto real de fondo, el texto queda sobre el lado izquierdo —
       oscurecer fuerte ahí y dejar la foto respirar a la derecha. */
    background: linear-gradient(
      100deg,
      rgb(26 26 26 / 82%) 0%,
      rgb(26 26 26 / 68%) 35%,
      rgb(43 57 41 / 35%) 65%,
      rgb(43 57 41 / 15%) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 46rem;
  }

  .hero-headline {
    font-family: var(--font-primary);
    font-weight: 900;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.15;
    color: var(--color-white);
    letter-spacing: -0.01em;
  }

  .hero-accent {
    color: var(--color-gold);
  }

  .hero-sub {
    font-family: var(--font-secondary);
    color: var(--color-light-gray);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    margin-top: var(--stack-sm);
    max-width: 38rem;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: var(--stack-md);
  }

  .hero-badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: var(--stack-md) 0 0;
    padding: 0;
  }

  .hero-badges li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-light-gray);
    font-family: var(--font-secondary);
    font-size: 0.85rem;
  }

  .hero-badges svg {
    width: 20px;
    height: 20px;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 560px;
      padding-block: var(--stack-lg) var(--stack-md);
    }
  }
</style>
