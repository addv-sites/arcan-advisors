---
/*
  Copy literal — Brand Book Arcan Advisors v1.0:
  - Esencia de marca: lámina "02. nuestra marcar"
  - Propósito / Misión / Visión / Valores: lámina "04. Estrategia de Marca"
*/
const pillars = [
  {
    key: 'proposito',
    title: 'Propósito',
    text: 'Aportar inteligencia estratégica que genere valor y transforme el futuro energético de manera sostenible.',
  },
  {
    key: 'mision',
    title: 'Misión',
    text: 'Brindamos asesoría estratégica, formación especializada y soluciones innovadoras para impulsar el desarrollo del sector energético en México y Latinoamérica.',
  },
  {
    key: 'vision',
    title: 'Visión',
    text: 'Ser la consultora de referencia en inteligencia energética en América Latina, reconocida por nuestra capacidad de anticipar el futuro y generar impacto positivo y sostenible.',
  },
];

const valores = [
  {
    title: 'Integridad',
    text: 'Actuamos con honestidad, transparencia y compromiso en cada proyecto.',
    icon: 'M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z M8.5 12.5l2.5 2.5 5-5',
  },
  {
    title: 'Excelencia',
    text: 'Buscamos la más alta calidad en nuestras soluciones y relaciones.',
    icon: 'M12 3l2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5-3.6-3.5 5-.7L12 3Z',
  },
  {
    title: 'Colaboración',
    text: 'Trabajamos junto a nuestros clientes y aliados para lograr objetivos comunes.',
    icon: 'M8 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M16 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M3 20c0-3 2.5-5 5-5s5 2 5 5 M11 20c0-3 2.5-5 5-5s5 2 5 5',
  },
  {
    title: 'Sostenibilidad',
    text: 'Promovemos soluciones que generan valor económico, social y ambiental.',
    icon: 'M12 2c4 3 6 6 6 10a6 6 0 1 1-12 0c0-4 2-7 6-10Z',
  },
  {
    title: 'Innovación',
    text: 'Impulsamos nuevas ideas y tecnologías para transformar el sector energético.',
    icon: 'M9 18h6 M10 21h4 M12 3a6 6 0 0 0-3.5 10.9c.6.4.9 1 .9 1.6v.5h5.2v-.5c0-.6.3-1.2.9-1.6A6 6 0 0 0 12 3Z',
  },
];
---

<section class="section" id="nosotros">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="section-eyebrow">Nosotros</p>
      <h2 class="section-title">
        Somos una consultora estratégica especializada en el sector energético de México y Latinoamérica.
      </h2>
      <p class="section-lead">
        Transformamos datos y conocimiento en decisiones inteligentes que generan valor, competitividad y sostenibilidad.
      </p>
    </div>

    <div class="cards-grid cards-grid--3" data-reveal-group>
      {pillars.map((pillar, i) => (
        <article class="card" data-reveal style={`--reveal-index:${i}`}>
          <h3>{pillar.title}</h3>
          <p>{pillar.text}</p>
        </article>
      ))}
    </div>

    <div class="valores" data-reveal-group>
      {valores.map((valor, i) => (
        <div class="valor-item" data-reveal style={`--reveal-index:${i}`}>
          <span class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={valor.icon} />
            </svg>
          </span>
          <div>
            <h4>{valor.title}</h4>
            <p>{valor.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .valores {
    margin-top: var(--stack-lg);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .valores {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .valores {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .valor-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .valor-item h4 {
    font-family: var(--font-primary);
    color: var(--color-primary);
    font-size: 1rem;
    margin: 0 0 0.35rem;
  }

  .valor-item p {
    font-family: var(--font-secondary);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
