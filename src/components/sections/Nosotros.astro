---
/*
  Copy actualizado según brief de reposicionamiento del cliente (clientCom.md,
  secciones 5-7): especialista senior en compra de energía para el MEM, no
  consultora ESG/transición energética. Reemplaza el copy original del Brand
  Book v1.0 (lámina "04. Estrategia de Marca"), que quedó obsoleto frente a
  este posicionamiento.
*/
const trayectoria =
  'Arcan Advisors nace de más de doce años de experiencia en posiciones de liderazgo senior en el sector eléctrico mexicano, incluyendo la originación del Suministrador Calificado con mayor volumen de energía suministrada en México.';

const modelo =
  'Operamos como una firma de consultoría independiente respaldada por una red de aliados estratégicos especializados. Para el acceso a datos del mercado, contamos con una plataforma profesional bajo licencia; para la intermediación de certificados de origen renovable y productos ambientales, trabajamos con aliados con presencia en mercados nacionales e internacionales. Este modelo permite ofrecer un servicio integral sin perder la atención directa del especialista.';

const enfoque =
  'El modelo de Arcan es el de un especialista de referencia: conoce el mercado con la profundidad de quien ha estado desde el inicio de su creación, garantiza atención senior en cada etapa del proceso, y mide su éxito no por la duración del contrato de consultoría, sino por la capacidad que desarrolla en sus clientes para tomar mejores decisiones, con o sin nuestro acompañamiento.';

const pillars = [
  {
    key: 'proposito',
    title: 'Propósito',
    text: 'Poner la experiencia del suministro al servicio del comprador de energía.',
  },
  {
    key: 'mision',
    title: 'Misión',
    text: 'Brindar asesoría estratégica y formación especializada para que los grandes consumidores y participantes del MEM compren energía en su mejor posición posible.',
  },
  {
    key: 'vision',
    title: 'Visión',
    text: 'Ser el especialista de referencia en estrategia de compraventa de energía en México.',
  },
];

const valores = [
  {
    title: 'Integridad',
    text: 'Actuamos con honestidad, transparencia y compromiso en cada proyecto.',
    icon: 'M12 2 3 6v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V6l-9-4Z M8.5 12.5l2.5 2.5 5-5',
  },
  {
    title: 'Innovación',
    text: 'Impulsamos nuevas ideas y herramientas para transformar la toma de decisiones en el sector eléctrico.',
    icon: 'M9 18h6 M10 21h4 M12 3a6 6 0 0 0-3.5 10.9c.6.4.9 1 .9 1.6v.5h5.2v-.5c0-.6.3-1.2.9-1.6A6 6 0 0 0 12 3Z',
  },
  {
    title: 'Independencia',
    text: 'No tenemos conflicto de interés con suministradores: nuestra función es representar estratégicamente los intereses del comprador.',
    icon: 'M8 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M16 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M3 20c0-3 2.5-5 5-5s5 2 5 5 M11 20c0-3 2.5-5 5-5s5 2 5 5',
  },
];
---

<section class="section" id="nosotros">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="section-eyebrow">Nosotros</p>
      <h2 class="section-title">Construyendo el mercado desde adentro</h2>
      <p class="section-lead">{trayectoria}</p>
    </div>

    <div class="nosotros-body" data-reveal-group>
      <p data-reveal style="--reveal-index:0">{modelo}</p>
      <p data-reveal style="--reveal-index:1">{enfoque}</p>
    </div>

    <h3 class="valores-title" data-reveal>Nuestros valores</h3>
    <div class="valores" data-reveal-group>
      {valores.map((valor, i) => (
        <div class="valor-item" data-reveal style={`--reveal-index:${i}`}>
          <span class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={valor.icon} />
            </svg>
          </span>
          <div>
            <h4>{valor.title}</h4>
            <p>{valor.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="cards-grid cards-grid--3 pillars-grid" data-reveal-group>
      {pillars.map((pillar, i) => (
        <article class="card" data-reveal style={`--reveal-index:${i}`}>
          <h3>{pillar.title}</h3>
          <p>{pillar.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .nosotros-body {
    display: grid;
    gap: 1.25rem;
    max-width: 56rem;
    margin-top: var(--stack-sm);
  }

  .nosotros-body p {
    font-family: var(--font-secondary);
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0;
    text-align: justify;
  }

  .pillars-grid {
    margin-top: var(--stack-lg);
  }

  .valores-title {
    margin-top: var(--stack-lg);
    font-size: 1.1rem;
    color: var(--color-primary);
  }

  .valores {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .valores {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .valores {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .valor-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .valor-item h4 {
    font-family: var(--font-primary);
    color: var(--color-primary);
    font-size: 1rem;
    margin: 0 0 0.35rem;
  }

  .valor-item p {
    font-family: var(--font-secondary);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
